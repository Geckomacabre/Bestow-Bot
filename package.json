{
  "name": "bestow",
  "description": "Free, privacy-first multipurpose Discord bot you add to your own account: economy, casino, giveaways, minigames, media editing, text-to-speech, AI tools, lookups and community tools. Derived from TMCBot (GPL-3.0-or-later).",
  "version": "1.0.0",
  "keywords": [
    "discord",
    "discord-bot",
    "discord-js",
    "user-install",
    "user-installable-app",
    "multipurpose-bot",
    "economy-bot",
    "casino",
    "giveaway-bot",
    "minigames",
    "text-to-speech",
    "media-editing",
    "privacy",
    "self-hosted",
    "bun",
    "typescript",
    "sqlite"
  ],
  "homepage": "https://github.com/Geckomacabre/Bestow-Bot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Geckomacabre/Bestow-Bot.git"
  },
  "bugs": {
    "url": "https://github.com/Geckomacabre/Bestow-Bot/issues"
  },
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start:production": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "validate": "bun scripts/validate-commands.ts",
    "docs": "bun scripts/gen-commands-doc.ts",
    "check": "bun run typecheck && bun run validate && bun test",
    "format": "prettier --write src",
    "build:native": "cmake-js compile --CDWITH_BACKWARD=OFF",
    "install": "cmake-js compile --CDWITH_BACKWARD=OFF || echo 'Native image addon build failed — libvips, fontconfig and cmake are required (apt install libvips-dev libfontconfig1-dev cmake). Native image effects are disabled without it.'"
  },
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/figlet": "^1.7.0",
    "@types/qrcode": "^1.5.6",
    "cmake-js": "^7.3.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.0",
    "@types/he": "^1.2.3",
    "@vvo/tzdb": "^6.198.0",
    "discord.js": "^14.26.4",
    "elysia": "^1.4.29",
    "figlet": "^1.11.4",
    "he": "^1.2.0",
    "jsqr": "^1.4.0",
    "kokoro-js": "^1.2.1",
    "msedge-tts": "^2.0.8",
    "node-addon-api": "^8.8.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4"
  }
}
