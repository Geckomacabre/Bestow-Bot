# ─── Required ────────────────────────────────────────────────────────────────
# Create a NEW application at https://discord.com/developers/applications, add a Bot, and paste its token here.
# Never commit this file, never paste the token anywhere public, and regenerate it immediately if it leaks.
TOKEN=
CLIENT_ID=
NODE_ENV=production

# ─── Discord privileged intents (Developer Portal → Bot) ─────────────────────
# Turn ON: "Server Members Intent" and "Message Content Intent".
# "Presence Intent" is OFF by default; only enable it (and set the line below) if you want streaming announcements.
# ENABLE_PRESENCE_INTENT=1

# ─── Data ────────────────────────────────────────────────────────────────────
# SQLite database location. Keep it on local disk — NOT inside OneDrive/Dropbox/iCloud (the bot refuses synced folders
# unless you set ALLOW_SYNCED_DB=1, because sync clients corrupt SQLite files).
# DB_PATH=./data/bestow.db
# ALLOW_SYNCED_DB=1
# LOG_LEVEL=info

# ─── AI (optional — any OpenAI-compatible provider: OpenAI, xAI/Grok, Groq, OpenRouter, Ollama, LM Studio…) ─────
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# The name shown in AI reply footers (default: the model id). Handy for a friendlier label, e.g. "OpenAI GPT-4o mini".
# LLM_LABEL=
# A second model for /ai llama (falls back to the model above when unset).
# LLAMA_BASE_URL=
# LLAMA_API_KEY=
# LLAMA_MODEL=
# LLAMA_LABEL=
# Image reading (/ai ocr|describe|geolocate, images in chat). Defaults to the chat model above if it can see images.
# VISION_BASE_URL=
# VISION_API_KEY=
# VISION_MODEL=
# Speech-to-text for /ai transcript (defaults to LLM_BASE_URL/LLM_API_KEY; model whisper-1).
# WHISPER_BASE_URL=
# WHISPER_API_KEY=
# WHISPER_MODEL=whisper-1
# /ai custom: models people can pick for their custom AI, on the LLM endpoint above ("Label=model-id, Label=model-id").
# Unset = the chat model and the Llama model.
# CUSTOM_AI_MODELS=
# /ai imagine and /ai edit-imagine: any OpenAI-compatible images API (Together, OpenAI, a local server…).
# A model id starting with "chat:" is sent to /chat/completions with image output instead (e.g. OpenRouter's Gemini image models).
# IMAGE_BASE_URL=https://api.together.xyz/v1
# IMAGE_API_KEY=
# IMAGE_MODEL_FLUX2_KLEIN=
# IMAGE_MODEL_FLUX1_SCHNELL=black-forest-labs/FLUX.1-schnell
# IMAGE_MODEL_P_IMAGE=
# IMAGE_MODEL_NANO_BANANA_2=
# IMAGE_EDIT_MODEL=
# /ai perplexity (Perplexity Sonar web search)
# PERPLEXITY_API_KEY=
# PERPLEXITY_MODEL=sonar
# /ai tts openai (OpenAI's speech voices; OPENAI_TTS_BASE_URL for a compatible server)
# OPENAI_API_KEY=
# OPENAI_TTS_BASE_URL=
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Cost control. Requests per person per hour (0 = unlimited), an optional total per day, and a kill switch.
# AI_USER_LIMIT=20
# AI_DAILY_LIMIT=0
# AI_DISABLED=1
# Reasoning models (like gpt-oss) get low reasoning effort plus token headroom automatically. Override: low, medium, high, or off.
# LLM_REASONING_EFFORT=low

# ─── Speech & singing (/tts) ─────────────────────────────────────────────────
# The free local voices download themselves on first use (~90 MB, cached in ./data/models). Nothing to configure.
# AI singers ("Singing" voices backed by a real music model) need an ACE-Step 1.5 server you run yourself:
# ACESTEP_URL=http://127.0.0.1:8001
# ACESTEP_API_KEY=
# SING_SECONDS=30
# SING_COOLDOWN_MS=60000
# ElevenLabs voices in /tts (optional, paid). Use the secret key that starts with "sk_" — NOT the key ID. Voices are read from your account.
# Each person gets ELEVENLABS_FREE_CHARS_PER_DAY characters a day (Premium: unlimited) and the whole bot is capped at ELEVENLABS_DAILY_CHARS.
# ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_flash_v2_5
# ELEVENLABS_FREE_CHARS_PER_DAY=1000
# ELEVENLABS_DAILY_CHARS=20000

# ─── Media tools ─────────────────────────────────────────────────────────────
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# FFMPEG_CONCURRENCY=2
# /media download uses yt-dlp. Optional cookies file if a site demands a login or bot check.
# YTDLP_PATH=yt-dlp
# YTDLP_COOKIES=
# /instagram repost reads the post with Instaloader (https://github.com/instaloader/instaloader; in the Docker image).
# Public posts work as they are. If Instagram wants a login, make a session with `instaloader --login=NAME` and point these at it
# (inside Docker, put the file on the data volume, e.g. /app/data/session-NAME).
# INSTALOADER_PYTHON=python3
# INSTALOADER_USER=
# INSTALOADER_SESSIONFILE=
# Headless Chromium for /website screenshot (click/delay), /website scroll and full-page captures. Set in the Docker image;
# without it, screenshots fall back to thum.io (no clicking).
# CHROMIUM_PATH=/usr/bin/chromium
# Set to 1 when Chromium's own sandbox can't start (inside Docker).
# CHROMIUM_NO_SANDBOX=1
# /crypto wallet|transaction for Bitcoin/Litecoin/Dogecoin/Dash work without a key; a free BlockCypher token raises the limit.
# BLOCKCYPHER_TOKEN=

# ─── Music ───────────────────────────────────────────────────────────────────
# /lastfm: an API account from https://www.last.fm/api/account/create. The secret enables the proper login and love/unlove;
# without it, /lastfm login just asks for a username.
# LASTFM_API_KEY=
# LASTFM_API_SECRET=
# /spotify search|album|cover: an app from https://developer.spotify.com (Deezer is used without it). Previews always come from Deezer.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# /shazam and the Identify Song menu: song recognition by AudD (https://audd.io).
# AUDD_API_TOKEN=

# ─── Web search (/tools search) ──────────────────────────────────────────────
# Point at your own SearXNG instance for real web results; without it the command searches Wikipedia.
# SEARXNG_URL=http://localhost:8080

# ─── Lookups (all optional; the commands work without keys but with tighter limits) ──
# A contact address added to the User-Agent of outgoing API requests (good manners toward free APIs).
# BOT_CONTACT=you@example.com
# GITHUB_TOKEN=
# YOUTUBE_API_KEY=
# TENOR_API_KEY=
# WEATHER_API_KEY=
# TMDB_API_KEY=
# RAWG_API_KEY=
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# /paste uses Pastebin (unlisted) with this key, otherwise paste.rs. Free key: https://pastebin.com/doc_api
# PASTEBIN_API_KEY=
# /define uses Merriam-Webster with this key, otherwise the free dictionaryapi.dev. Free key: https://dictionaryapi.com
# MW_DICTIONARY_KEY=
# Any bot token from @BotFather. Lets /convert telegramuser2id read the numeric ID of public channels and groups.
# TELEGRAM_BOT_TOKEN=
# /valorant user|history|match|store use HenrikDev's API. Free key from the HenrikDev Discord (https://docs.henrikdev.xyz).
# HENRIK_API_KEY=
# /fortnite user (Battle Royale stats). Free key: https://dash.fortnite-api.com
# FORTNITE_API_KEY=
# /ton works without a key; one from https://tonconsole.com raises the rate limit.
# TONAPI_KEY=
# /roblox followers|following: Roblox only shows those lists to a logged-in account. Put the .ROBLOSECURITY cookie of a SPARE
# account here (never your main one — it grants full access to that account).
# ROBLOX_COOKIE=

# ─── Web dashboard ───────────────────────────────────────────────────────────
# WEB_PORT=3000
# WEB_URL=https://bot.example.com      # use https in production (the session cookie becomes Secure)
# DISCORD_CLIENT_SECRET=               # OAuth2 client secret, needed to sign in to the dashboard

# ─── Ownership ───────────────────────────────────────────────────────────────
# OWNER_IDS=123456789012345678,234567890123456789
# OWNER_GUARD=false
# REPORT_CHANNEL_ID=

# ─── Premium (optional) ──────────────────────────────────────────────────────
# Free accounts get AI_USER_LIMIT AI requests per hour (default 20); Premium removes that limit. To sell it:
#  1. Developer Portal → Monetization: create a subscription SKU (and, for gifts, a consumable SKU), then put their IDs here.
#  2. Discord handles payment; the bot only reads the entitlement. Owners (OWNER_IDS) always have Premium and can /premium grant.
# PREMIUM_SKU_ID=
# PREMIUM_GIFT_SKU_ID=
# PREMIUM_GIFT_DAYS=30
# Optional: your support server. Used by /eco joinbonus (a one-time bonus for members) and, with PREMIUM_ROLE_ID, /premium syncrole.
# SUPPORT_GUILD_ID=
# Optional: shown to people who run /eco joinbonus before they have joined the support server.
# SUPPORT_INVITE=https://discord.gg/yourinvite
# PREMIUM_ROLE_ID=
# Optional: a second copy of the bot ("Bestow+") that /plus links to. Its application ID from the Developer Portal.
# PLUS_CLIENT_ID=
# Optional: where people can donate (Ko-fi, Patreon…). Shown as a button on /donate leaderboard.
# DONATE_URL=https://ko-fi.com/yourname
